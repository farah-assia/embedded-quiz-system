# ==============================================================================
# κουίζυ (Quizy) — Environment Configuration Template
# Copy this file to .env and configure for your local/production environment
# NEVER commit your production .env with real secrets to version control!
# ==============================================================================

# Server Network Configuration
PORT=7000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=quiz_app

# JWT Security Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_this_to_a_secure_random_key_in_production_min_32_chars
REFRESH_TOKEN_SECRET=change_this_to_a_secure_refresh_key_in_production_min_32_chars

# Optional Admin / Registration Protection
TEACHER_REGISTRATION_SECRET=optional_admin_passcode_for_teacher_registration
